        "规模化计划"
      ]
    }
  ],
  "cohort_rules": {
    "benchmark": {
      "label": "标杆候选",
      "minimum_evidence": 6,
      "minimum_independent_source_categories": 3,
      "minimum_observation_periods": 2,
      "requirements": [
        "至少三类结果维度达到可核查的持续表现",
        "不存在未处理的关键交易或数据风险",
        "负责人职责关系可核查"
      ]
    },
    "control": {
      "label": "普通对照",
      "minimum_evidence": 4,
      "minimum_independent_source_categories": 2,
      "minimum_observation_periods": 1,
      "requirements": [
        "与智能体商业直接相关但尚未证明持续成功",
        "允许处于试验、转型或早期商业化阶段"
      ]
    },
    "risk": {
      "label": "风险对照",
      "minimum_evidence": 4,
      "minimum_independent_source_categories": 2,
      "minimum_observation_periods": 1,
      "requirements": [
        "至少存在一个可核查的经营、交易安全、合规或治理风险信号",
        "风险不得仅凭媒体评价或同名记录认定"
      ]
    }
  },
  "review_stages": [
    {
      "code": "discovered",
      "name": "已发现",
      "meaning": "已定位负责人和赛道相关资料"
    },
    {
      "code": "collecting",
      "name": "采集中",
      "meaning": "事实证据尚未达到分组准入要求"
    },
    {
      "code": "ready_for_review",
      "name": "待复核",
      "meaning": "证据结构完整，等待人工核查归因"
    },
    {
      "code": "approved",
      "name": "已批准",
      "meaning": "人工确认后可进入跨样本归因"
    }
  ],
  "template_learning_rules": [
    "跨样本分析只使用已复核证据，企业事实不自动归因到负责人",
    "每个特质必须在标杆组重复出现，并与对照组或风险组形成差异",
    "归因结果只能生成评分维度、证据要求、锚点或权重的修改建议",
    "AI不得自动修改、发布模板或作出投资结论",
    "系统不设置额外的样本批准层，人工复核证据和人工确认模板修改即可"
  ],
  "minimum_pilot_cohort": {
    "benchmark": 6,
    "control": 6,
    "risk": 4,
    "note": "用于MVP归因验证，不代表统计显著性要求。"
  }
